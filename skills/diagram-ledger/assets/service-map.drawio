<mxfile host="diagram-ledger">
  <diagram id="service-map" name="Service map">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="8" page="1" pageScale="1" pageWidth="1200" pageHeight="700" background="#F8FAFC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="heading" value="Order lookup · service map" style="text;html=0;align=left;verticalAlign=middle;fontSize=30;fontFamily=Arial;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="48" y="32" width="1000" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Illustrative topology · arrows show requests and reads; responses omitted" style="text;html=0;align=left;fontSize=16;fontFamily=Arial;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="48" y="88" width="1080" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="backend" value="Application services · logical grouping" style="swimlane;html=0;startSize=48;horizontal=1;rounded=1;fillColor=#ECFEFF;swimlaneFillColor=#FFFFFF;strokeColor=#64748B;fontColor=#155E75;fontFamily=Arial;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="392" y="176" width="720" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="Web client" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#172033;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="64" y="304" width="208" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="orders-api" value="Orders API" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fillColor=#ECFEFF;strokeColor=#155E75;fontColor=#155E75;spacing=16;" vertex="1" parent="backend">
          <mxGeometry x="48" y="128" width="208" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="orders-store" value="Orders database" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;size=16;fontFamily=Arial;fontSize=18;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#172033;spacing=16;" vertex="1" parent="backend">
          <mxGeometry x="440" y="112" width="224" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="client-to-api" value="HTTPS request" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#475569;fontFamily=Arial;fontSize=14;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="orders-api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="api-to-store" value="Read orders" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#475569;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="backend" source="orders-api" target="orders-store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Scope: the lookup path only. Authentication, deployment, and failure behavior are unspecified." style="text;html=0;align=left;whiteSpace=wrap;fontSize=16;fontFamily=Arial;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="48" y="552" width="1080" height="64" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
